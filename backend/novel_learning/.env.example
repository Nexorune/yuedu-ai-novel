# 模型无关：换服务商只改这三行（Anthropic 兼容网关均可）

# 方案 A：AIHubMix 中转（一个 Key 用多家模型，Anthropic 兼容接口）
ANTHROPIC_API_KEY=sk-xxx
ANTHROPIC_BASE_URL=https://aihubmix.com
MODEL_ID=deepseek-v3.2

# 方案 B：DeepSeek 官方（Anthropic 兼容接口）
# ANTHROPIC_API_KEY=sk-xxx
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# MODEL_ID=deepseek-chat

# 可选护栏
# CHAPTER_MAX_TOKENS=8192
# REWRITE_LIMIT=2
# DAILY_GEN_LIMIT=20

# 月度费用熔断（默认 50 元/月，到顶自动停）
# MONTHLY_COST_LIMIT=50
# PRICE_INPUT_PER_1M=4
# PRICE_OUTPUT_PER_1M=12
